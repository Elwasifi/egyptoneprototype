# Egypt One — environment variables (example only, no real secrets)
# Copy to .env.local (web) / .env (scripts) and fill in per environment.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
EGYPT_ONE_APP_NAME="Egypt One"
EGYPT_ONE_DEFAULT_LOCALE=en

# --- Database (Prisma / PostgreSQL) ------------------------------------
# Leave unset to run in DEMO_MODE (in-memory seeded JSON, no real database).
# DATABASE_URL=postgresql://egyptone:changeme@localhost:5432/egyptone

# --- Cache / queues ------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# --- Search ----------------------------------------------------------------
# OPENSEARCH_URL=http://localhost:9200

# --- Object storage (S3-compatible) --------------------------------------
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=egypt-one-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Revenue configuration -----------------------------------------------
# Base negotiation assumption only — never a hardcoded global commission.
# Individual service classes may override this in packages/config/src/revenue.ts.
EGYPT_ONE_BASE_COMMISSION_PCT=5

# --- Payments (PSP-abstracted; sandbox by default) ------------------------
# PAYMENTS_PROVIDER=sandbox
# PAYMENTS_API_KEY=

# --- AI / MCP --------------------------------------------------------------
# AI_SERVICE_URL=http://localhost:4100
# All MCP tool states (PLANNED / SANDBOX / LIVE / DISABLED) are declared in
# packages/mcp/src/registry.ts — no separate env flag flips a tool to LIVE.

# --- Maps ------------------------------------------------------------------
# Egypt One ships a vendor-neutral schematic map by default. Set a provider
# only if/when a licensed map vendor is contracted.
EGYPT_ONE_MAP_PROVIDER=schematic
# MAPBOX_TOKEN=

# --- Auth / sessions ---------------------------------------------------
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# --- Observability -------------------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=info
